# IIS 服务公共环境变量
# 路径以部署机器实际位置为准
PROJECT_DIR=/path/to/IntelligenceIntegrationSystem
PYTHONPATH=/path/to/IntelligenceIntegrationSystem

# 限制数值计算库线程数，避免在容器中抢占过多 CPU
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# 禁用 tokenizers 多进程警告
TOKENIZERS_PARALLELISM=false

# 禁用 CUDA（IIS 推理不需要 GPU）
CUDA_VISIBLE_DEVICES=""

# VectorDB 管理端点(/api/admin/*) token；留空时管理端点保持禁用(503 fail-closed)，
# 数据端点(health/search/upsert)不受影响，但启动日志会有显眼告警。
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
VECTOR_ADMIN_TOKEN=
