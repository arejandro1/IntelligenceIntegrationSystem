# ============================================================
# 示例环境变量文件（M0）
# 用途：展示配置骨架，仅含示例键和占位值
# 警告：请复制为 .env 后填写真实值；真实密钥禁止提交到仓库
# ============================================================

# --- AI 消费者开关（M1/M2 默认） ---
API_ENABLED=false
API_DRY_RUN=true

USE_LEGACY_AI_WORKER=false
USE_OFF_PEAK_DRAINER=false

# --- DeepSeek 峰谷策略 ---
DEEPSEEK_OFF_PEAK_ONLY=true
DEEPSEEK_TIME_POLICY_FAIL_CLOSED=true
DEEPSEEK_BILLING_TIMEZONE=Asia/Shanghai

DEEPSEEK_PEAK_WINDOWS=09:00-12:00,14:00-18:00
DEEPSEEK_PEAK_PRICE_MULTIPLIER=2.0
DEEPSEEK_OFF_PEAK_PRICE_MULTIPLIER=1.0

DEEPSEEK_POLICY_VERSION=
DEEPSEEK_POLICY_EFFECTIVE_FROM=
DEEPSEEK_POLICY_EXPIRES_AT=

# --- Guard 与队列 Drain 参数 ---
OFF_PEAK_START_GUARD_MINUTES=1
OFF_PEAK_END_GUARD_MINUTES=10
OFF_PEAK_QUEUE_DRAIN_INTERVAL_SECONDS=30
OFF_PEAK_MAX_STARTS_PER_MINUTE=2
OFF_PEAK_QUEUE_MAX_AGE_HOURS=168
OFF_PEAK_QUEUE_MAX_RETRIES=3

# --- 预算限制 ---
DAILY_API_BUDGET_CNY=
MONTHLY_API_BUDGET_CNY=
DAILY_API_CALL_LIMIT=
MONTHLY_API_CALL_LIMIT=

# --- DeepSeek 模型与密钥（占位，禁止填入真实密钥） ---
DEEPSEEK_FLASH_MODEL=
DEEPSEEK_PRO_MODEL=
DEEPSEEK_API_KEY=<set-locally>

# --- MongoDB（占位，禁止填入真实密码） ---
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=