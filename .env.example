# ============================================================
# 示例环境变量文件（P0-3 修订）
# 用途：仅保存“确实会被读取”的环境变量；其余配置一律以
#       _config/config.json 为唯一来源
# 警告：请复制为 .env 后填写真实值；真实密钥禁止提交到仓库
# ============================================================

# --- 配置来源说明（P0-3 统一生效规则） ---
# china_watch 功能开关（api_enabled / api_dry_run / use_legacy_ai_worker /
# use_off_peak_drainer）、峰谷时段、Guard、预算、价格、推送与磁盘策略的
# 唯一配置来源是 _config/config.json 的 intelligence_hub.* 键。
# 历史上此处的 API_DRY_RUN / USE_LEGACY_AI_WORKER / USE_OFF_PEAK_DRAINER
# 等键从未被任何代码读取，已删除，避免“看似有效实则无效”的误导。
# 布尔值解析为严格模式：JSON 中必须是 true/false；写成字符串 "false"
# 会在启动时直接报错（fail-fast），不再被 bool("false") 误判为真。

# --- Token（GlobalConfig.py 真读，配合 deny_on_empty_config fail-closed） ---
# 未配置时为空字符串；服务端会因空配置拒绝请求，禁止硬编码弱凭证回退。
DEFAULT_RPC_API_TOKEN=
DEFAULT_COLLECTOR_TOKEN=
DEFAULT_PROCESSOR_TOKEN=

# --- 认证数据库路径覆盖（GlobalConfig.py 真读 AUTH_DB_PATH，P0-2） ---
# 默认 _data/Authentication.db（可写持久化目录）；存在旧库
# （_config/Authentication.db 或项目根）时启动自动迁移复制并告警。
# 仅特殊部署需要覆盖时设置。
# AUTH_DB_PATH=

# --- AI 客户端密钥（OpenAICompatibleAPI.py / ai_client_config_example.py 真读，占位） ---
SILICON_API_KEY=<set-locally>
# GEMINI_API_KEY=<set-locally>
# ZHIPU_API_KEY=<set-locally>
# OPENAI_API_KEY=<set-locally>
# NVIDIA_API_KEY=<set-locally>
# LONGCAT_API_KEY=<set-locally>
# MIMO_API_KEY=<set-locally>
# MODELSCOPE_API_KEY=<set-locally>
DEEPSEEK_API_KEY=<set-locally>

# --- VectorDB 服务端口（VectorDB/VectorDBBService.py 真读 VECTOR_PORT） ---
# 对应 config.json 中的 intelligence_hub.vectordb.vector_db_port
VECTOR_PORT=8001

# --- VectorDB 管理端点 token（VectorDB/VectorDBBService.py 真读 VECTOR_ADMIN_TOKEN） ---
# 用于 /api/admin/*（备份/恢复等管理接口）；留空时管理端点 fail-closed 返回 503，
# 数据端点不受影响，但启动日志会有显眼告警。
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
VECTOR_ADMIN_TOKEN=

# --- MongoDB 连接（P0-4：外部数据库模式必填；docker-compose.yml 真读） ---
# DS920+（J4125 无 AVX）不能运行 mongo:5.0+ 容器，默认连接外部兼容硬件上的
# MongoDB；本地容器模式（AVX 主机）由 docker-compose.local-mongo.yml 覆盖为
# 服务名 china-watch-mongo，此时以下值可保持与 MONGO_INITDB_* 一致。
MONGO_HOST=<set-locally>
MONGO_PORT=27017
MONGO_USER=<set-locally>
MONGO_PASSWORD=<set-locally>
# 仅本地容器模式（docker-compose.local-mongo.yml）使用：
MONGO_INITDB_ROOT_USERNAME=<set-locally>
MONGO_INITDB_ROOT_PASSWORD=<set-locally>

# --- 爬虫治理 Token（IntelligenceCrawler/CrawlerGovernanceBackend.py 真读） ---
CRAWLER_GOVERNANCE_TOKEN=

# --- Web 服务监听（IntelligenceHubLauncher.py 真读 FLASK_DEBUG，仅开发环境） ---
FLASK_DEBUG=

# ============================================================
# 以下键为 config.json 的配置键（非环境变量），经 EasyConfig 读取。
# 若需修改请编辑 _config/config.json，而非 .env：
#   - MongoDB：intelligence_hub.mongodb.host / port / user / password
#     （容器部署用上方 MONGO_* 环境变量覆盖，优先级：env > config.json）
#   - china_watch 开关：intelligence_hub.china_watch.*
#   - 峰谷策略/预算/模型价格：intelligence_hub.api_policy.* / budget.* / pricing.*
#   - 推送渠道：intelligence_hub.push_notifier.*
#   - 磁盘降级阈值：intelligence_hub.disk_guard.*
# ============================================================
