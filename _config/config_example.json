{
  "intelligence_hub": {
    "ai_analysis_thread": 1,
    "similar_recall_enabled": true,
    "max_unarchived_load": 10000,
    "archive_retry_max": 5,
    "china_watch": {
      "api_enabled": false,
      "api_dry_run": true,
      "use_legacy_ai_worker": false,
      "use_off_peak_drainer": false,
      "crawler_concurrency": {
        "normal": 2,
        "playwright": 1,
        "pdf_worker": 1,
        "ai_worker": 1
      }
    },
    "prefilter": {
      "enabled": true,
      "min_content_length": 10,
      "require_title": true,
      "reject_patterns": [
        "赌博",
        "gambling",
        "casino",
        "色情",
        "porn"
      ],
      "metadata_only_patterns": []
    },
    "api_policy": {
      "off_peak_only": true,
      "fail_closed": true,
      "billing_timezone": "Asia/Shanghai",
      "peak_windows": [
        "09:00-12:00",
        "14:00-18:00"
      ],
      "peak_price_multiplier": 2.0,
      "off_peak_price_multiplier": 1.0,
      "off_peak_start_guard_minutes": 1,
      "off_peak_end_guard_minutes": 10,
      "queue_drain_interval_seconds": 30,
      "max_starts_per_minute": 2,
      "policy_version": "",
      "effective_from": ""
    },
    "budget": {
      "daily_api_budget_cny": 0,
      "monthly_api_budget_cny": 0,
      "daily_api_call_limit": 0,
      "monthly_api_call_limit": 0,
      "daily_api_warn_cny": 0,
      "monthly_api_warn_cny": 0
    },
    "pricing": {
      "flash_model": "deepseek-v4-flash",
      "pro_model": "deepseek-v4-pro",
      "flash_input_cny_per_1k": 0.001,
      "flash_output_cny_per_1k": 0.002,
      "pro_input_cny_per_1k": 0.003,
      "pro_output_cny_per_1k": 0.006
    },
    "push_notifier": {
      "_comment": "P1-7 推送服务：归档总分达到 min_total_score 的情报写入 push_tasks 持久化队列，由 china-watch-notifier 容器消费并发送到 webhook。enabled=false 或 webhook_url 为空时明确显示禁用，不伪报成功。",
      "enabled": false,
      "webhook_url": "",
      "secret_token": "",
      "min_total_score": 7.0,
      "timeout_seconds": 10,
      "max_retries": 3,
      "retry_backoff_seconds": 2,
      "allow_private_webhook": false,
      "poll_interval_seconds": 10
    },
    "disk_guard": {
      "_comment": "P1-8/批次四 磁盘三级降级：>=warn_percent 告警；>=stop_push_percent 停止推送入队；>=stop_collect_percent 停止采集与队列消费并暂停新增付费请求（核心查询与告警保留，在途请求自然完成，已付费结果的交付与重放继续）。watch_path 相对路径以项目根为基准（示例值 _data 即项目根下的 _data 目录，不会拼出 _data/_data）。",
      "enabled": true,
      "watch_path": "_data",
      "interval_seconds": 300,
      "warn_percent": 70,
      "stop_push_percent": 85,
      "stop_collect_percent": 95
    },
    "mongodb": {
      "host": "localhost",
      "port": 27017,
      "user": "",
      "password": ""
    },
    "systemd_watchdog": {
      "enabled": true,
      "interval_sec": 10
    },
    "vectordb": {
      "enabled": false,
      "vector_db_path": "vectordb",
      "embedding_model_name": "BAAI/bge-m3",
      "stores": [
        {
          "collection_name": "intelligence_full_text",
          "chunk_size": 512,
          "chunk_overlap": 50,
          "description": "Index of raw data full text."
        },
        {
          "collection_name": "intelligence_summary",
          "chunk_size": 256,
          "chunk_overlap": 30,
          "description": "Index of processed data 'EVENT_TITLE' + 'EVENT_BRIEF' + 'EVENT_TEXT'."
        }
      ]
    }
  },
  "intelligence_hub_web_service": {
    "session_cookie_secure": true,
    "_comment_session_cookie_secure": "仅在 HTTPS 部署时开启；纯 HTTP 部署必须改为 false，否则浏览器不回传登录 Cookie 导致无法登录。",
    "trusted_proxies": [],
    "_comment_trusted_proxies": "反向代理（nginx 等）部署时填写代理服务器 IP 列表，用于采信 X-Forwarded-For / X-Real-IP；直连部署保持空列表。",
    "service": {
      "listen_ip": "0.0.0.0",
      "listen_port": 5000,
      "host_url": "http://127.0.0.1:5000",
      "secret_key": "CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_MIN_32_CHARS"
    },
    "rpc_api": {
      "tokens": [
        "<generate-uuid4-here>"
      ]
    },
    "collector": {
      "tokens": [
        "<generate-uuid4-here>"
      ]
    },
    "processor": {
      "tokens": [
        "<generate-uuid4-here>"
      ]
    },
    "public_search": {
      "mongo_max_per_page": 20,
      "mongo_max_page": 5,
      "mongo_default_window_days": 30,
      "vector_max_per_page": 10,
      "vector_max_top_n": 20,
      "vector_max_page": 2,
      "vector_allow_fulltext": false,
      "vector_allow_similar": false,
      "vector_min_score_threshold": 0.6,
      "vector_default_window_days": 30,
      "requests_per_minute": 10,
      "max_concurrent_vector": 5
    }
  },
  "monitor": {
    "update_interval_sec": 5.0,
    "thread_stats_interval_sec": 10.0
  },
  "ai_client_center": {
    "sqlite_db_file": "ai_client_state_log.db",
    "heartbeat_interval_sec": 30,
    "heartbeat_grace_sec": 120
  },
  "collector": {
    "submit_ihub_url": "http://127.0.0.1:5000",
    "cn_site_proxy": {},
    "global_site_proxy": {
      "http": "http://127.0.0.1:10809",
      "https": "http://127.0.0.1:10809"
    },
    "default_token": "<generate-uuid4-here>"
  },
  "processor": {
    "default_token": "<generate-uuid4-here>"
  }
}